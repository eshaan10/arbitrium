# --- Database ---
# Used by both the app and Alembic. Inside Docker Compose the host is "postgres".
POSTGRES_USER=marketedge
POSTGRES_PASSWORD=marketedge
POSTGRES_DB=marketedge
DATABASE_URL=postgresql+psycopg://marketedge:marketedge@postgres:5432/marketedge

# --- Kalshi (Phase 1) ---
# Public market-read endpoints require no auth. Base URL kept configurable.
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_POLL_INTERVAL_SECONDS=300
# Comma-separated Kalshi series to ingest (server-side scoping). If empty, the
# ingest logs a warning and does nothing — it will NOT fetch every open market.
# Replace with the real single-game moneyline series tickers for your sports.
KALSHI_SERIES_TICKERS=
# Client-side moneyline ticker guard (regex). Default screens out
# multi-game / cross-category / parlay markets.
KALSHI_MONEYLINE_PATTERN=^(?!.*(?:MULTIGAME|CROSSCATEGORY|MULTI|PARLAY)).+$

# --- The Odds API (Phase 2 — not used in Phase 1) ---
ODDS_API_BASE=https://api.the-odds-api.com/v4
ODDS_API_KEY=

# --- App ---
LOG_LEVEL=INFO
